<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <SharedConfigWatcher>$(MSBuildThisFileDirectory)ConfigWatcher.cs</SharedConfigWatcher>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildProjectDirectory)\ConfigWatcher.cs" />
  </ItemGroup>

  <Target Name="SyncConfigWatcher" BeforeTargets="BeforeCompile">
    <Error Condition="!Exists('$(SharedConfigWatcher)')"
           Text="Shared ConfigWatcher not found at $(SharedConfigWatcher)." />
    <Copy SourceFiles="$(SharedConfigWatcher)"
          DestinationFiles="$(MSBuildProjectDirectory)\ConfigWatcher.cs"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
